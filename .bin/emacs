#!/usr/bin/env bash

is-term-p() {
    case $TERM in
	dumb) return 1 ;;
	   *) return 0
    esac
}

emacs() {
    set -x
    # shellcheck disable=SC1091
    source "$HOME/.bashrc.d/999-emacs.rc"

    local finput
    local -a flags
    readarray finput < <(printf "%s" "$*")
    
    flags=(
	"--display=${DISPLAY:-$WAYLAND_DISPLAY}"
	"--socket-name=$XDG_RUNTIME_DIR/emacs/server"
    )

    emacs-dead-p && emacsctl start

    is-term-p && flags+=("--tty") || flags+=("--reuse-frame")

    # shellcheck disable=SC2068,SC2128
    if [[ -z $finput ]]; then
	command emacsclient ${flags[@]} ||
	    {
		emacsctl restart && command emacsclient ${flags[@]}
	    }	
    else
	command emacsclient ${flags[@]} ${finput[@]} ||
	    {
		emacsctl restart && command emacsclient ${flags[@]} ${finput[@]}
	    }
    fi    
    set +x
} 

main() {
    local log
    
    is-term-p && log="emacs-tty.log" || log="emacs-gui.log"
    
    emacs "$@" 2>"$HOME/.emacs.d/$log"
}

main "$@"

exit 0
