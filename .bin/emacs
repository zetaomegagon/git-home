#!/usr/bin/env bash

is-term-p() {
    case $TERM in
	tmux*|xterm*) return 0 ;;
	        dumb) return 1 ;;
	           *) return 0
    esac    
}

emacs() {
    set -x

    # shellcheck disable=SC1091
    source "$HOME/.bashrc.d/12-emacs.rc"

    local finput
    local -a flags
    readarray finput < <(printf "%s" "$*")
    
    flags=(
	"--display=${DISPLAY:-$WAYLAND_DISPLAY}"
	"--socket-name=$XDG_RUNTIME_DIR/emacs/server"
    )

    emacs-dead-p && emacsctl start

    if is-term-p; then
	flags+=("--tty")
    else
	flags+=("--reuse-frame")
    fi

    # shellcheck disable=SC2068,SC2128
    if [[ -z $finput ]]; then
	command emacsclient ${flags[@]}
    else
	command emacsclient ${flags[@]} ${finput[@]}
    fi
    
    set +x
} 

declare log input

if is-term-p; then
    log="emacs-term.log"
else
    log="emacs-gui.log"
fi

readarray input < <(printf "%s" "$*")

emacs "${input[@]}" 2>"$HOME/.emacs.d/$log"

exit 0
