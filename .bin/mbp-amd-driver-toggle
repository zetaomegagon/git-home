#!/usr/bin/env bash

input="${1/--/}"

get-current-gpu() {
    # if called interactively print the current GPU
    # else only return exit status
    local input="${1/--/}"

    if [[ "$input" = interactive ]]; then
	lspci -k | grep -iE 'k.*e: (radeon|amdgpu)' | tr -d ' ' | cut -d ':' -f 2
    else
	grep -q 'radeon.si_support=1' /etc/default/grub
    fi
}

is-gpu-radeon() {
    get-current-gpu
}

toggle-gpu-on-or-off() {
    confirmation-msg() {
	local dgpu_or_igpu

	is-gpu-radeon && dgpu_or_igpu=iGPU || dgpu_or_igpu=dGPU

	printf "%s\n" "Will use ${dgpu_or_igpu}"
    }

    toggle-dgpu-on() {
	sudo grubby \
	     --remove-args="radeon.si_support=1" \
	     --remove-args="amdgpu.si_support=0" \
	     --args="radeon.si_support=0" \
	     --args="amdgpu.si_support=1" \
	     --args="acpi_backlight=native" \
	     --update-kernel=ALL || exit 1
    }

    toggle-dgpu-off() {
	sudo grubby \
	     --remove-args="acpi_backlight=native" \
	     --remove-args="radeon.si_support=0" \
	     --remove-args="amdgpu.si_support=1" \
	     --args="radeon.si_support=1" \
	     --args="amdgpu.si_support=0" \
	     --update-kernel=ALL || exit 1
    }
    
    if is-gpu-radeon; then
	toggle-dgpu-on
	confirmation-msg
    else
	toggle-dgpu-off
	confirmation-msg
    fi
}

usage-msg() {
    echo "Usage: ${0##*/} [--toggle|--swtich|--current]"
}

case "$input" in
    toggle|switch) toggle-gpu-on-or-off ;;
          current) get-current-gpu --interactive ;;
                *) usage-msg
esac
